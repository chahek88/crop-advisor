# Copy to .env (docker compose reads it) or export in your shell.
CA_API_KEY=change-me-to-a-long-random-string
CA_API_URL=http://localhost:8000

# Optional MQTT ingest (leave CA_MQTT_HOST empty to disable)
CA_MQTT_HOST=
CA_MQTT_PORT=1883
CA_MQTT_USERNAME=
CA_MQTT_PASSWORD=
CA_MQTT_TOPIC=cropadvisor/plots/+/readings

# Sensor behaviour
CA_SENSOR_STALE_MINUTES=60
# Unit calibration: multiply raw sensor N/P/K by these to match the training data units
CA_N_FACTOR=1.0
CA_P_FACTOR=1.0
CA_K_FACTOR=1.0

# Development only: fake weather when you have no internet. Shown as MOCK in the UI.
CA_MOCK_WEATHER=0
CA_USE_SOILGRIDS=1
